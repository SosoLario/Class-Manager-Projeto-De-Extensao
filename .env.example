# Copie este arquivo para .env apenas quando configurar um ambiente local.
# Nunca coloque valores reais neste arquivo de exemplo.
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=classmanager_v2
DB_USER=root
DB_PASSWORD=

# Opcional: para envio de e-mails, configure remetente e PHP mail() no servidor.
MAIL_FROM=ClassManager <no-reply@example.test>

# Defina antes de executar o gerador inicial de contas demonstrativas.
SEED_ADMIN_EMAIL=admin@classmanager.test
SEED_ADMIN_PASSWORD=classmanager
SEED_DEMO_PASSWORD=classmanager
